#!/usr/bin/env bash
# Docs-only commits (just CLAUDE.md, the fleet-wide canonical doc sync)
# skip the full check suite below — it has nothing to check.
if [ "$(git diff --cached --name-only)" = "CLAUDE.md" ]; then
  exit 0
fi
set -euo pipefail

npm run lint
npm run typecheck
npx prettier --check .

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "gitleaks is required for pre-commit. Install it from https://github.com/gitleaks/gitleaks"
  exit 1
fi

gitleaks protect --staged --redact
